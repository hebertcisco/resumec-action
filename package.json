{
  "name": "resumec-action",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GitHub Action for validating and building resumes with resumec",
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.js --bundle --platform=node --target=node24 --format=cjs --minify --sourcemap --legal-comments=external --outfile=dist/index.cjs",
    "test": "node --test",
    "check": "npm run test && npm run build"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/tool-cache": "4.0.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "MIT"
}
